{{!< default}}
<div class="wrap listing">
  {{#author}}
  <header class="listing-head">
    <h1>{{name}}</h1>
    {{#if bio}}<p>{{bio}}</p>{{/if}}
  </header>
  {{/author}}
  <h2 class="visually-hidden">Articles by this author</h2>
  <div class="grid">{{#foreach posts}}{{> card}}{{/foreach}}</div>
  {{pagination}}
</div>
