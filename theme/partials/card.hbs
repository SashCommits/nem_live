<article class="card {{post_class}}">
  <a class="card-link" href="{{url}}">
    {{#if feature_image}}
    {{!-- sizes tracks the grid: 1 column on phones, 2 up to 1000px, 3 above. --}}
    <img class="card-img" loading="lazy" decoding="async"
      srcset="{{img_url feature_image size="s"}} 400w, {{img_url feature_image size="m"}} 800w"
      sizes="(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 380px"
      width="800" height="500"
      src="{{img_url feature_image size="m"}}" alt="">
    {{else}}
    <div class="imgph" aria-hidden="true"></div>
    {{/if}}
    {{#primary_tag}}<span class="kicker">{{name}}</span>{{/primary_tag}}
    <h3 class="card-title">{{title}}</h3>
    <p class="card-excerpt">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="26"}}{{/if}}</p>
  </a>
</article>
