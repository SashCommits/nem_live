<section class="subscribe" id="subscribe">
  <div class="wrap subscribe-inner">
    <div class="subscribe-copy">
      <h2>{{@site.title}} Weekly</h2>
      <p>The week's biggest moves in electricity markets and electrification, plus the dashboard update.</p>
    </div>
    <form class="subscribe-form" data-members-form="subscribe">
      <label for="subscribe-email">Email address</label>
      <div class="subscribe-row">
        <input id="subscribe-email" data-members-email type="email" required autocomplete="email" placeholder="you@company.com">
        <button class="btn primary" type="submit">Subscribe</button>
      </div>
      <p class="form-msg form-success" role="status">Check your inbox to confirm your subscription.</p>
      <p class="form-msg form-error" role="alert">Couldn't subscribe. Check the address and try again.</p>
    </form>
  </div>
</section>
