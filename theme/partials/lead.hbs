<section class="lead wrap" aria-label="Main story">
  <a class="lead-text" href="{{url}}">
    {{#primary_tag}}<span class="kicker">{{name}}</span>{{/primary_tag}}
    <h1 class="lead-title">{{title}}</h1>
    <p class="lead-deck">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="40"}}{{/if}}</p>
    <span class="meta">By {{authors autolink="false"}}, {{reading_time minute="1 min read" minutes="% min read"}}</span>
  </a>
  {{#if feature_image}}
  {{!-- Usually the largest-contentful element on the homepage, so it stays
        eager and is fetched at high priority rather than being queued. --}}
  <img class="lead-img"
    srcset="{{img_url feature_image size="s"}} 400w, {{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 2000w"
    sizes="(max-width: 1000px) 100vw, 40vw"
    src="{{img_url feature_image size="l"}}"
    width="1200" height="750" fetchpriority="high" decoding="async"
    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
  {{else}}
  <div class="imgph lead-img" aria-hidden="true"></div>
  {{/if}}
</section>
