{{!< default}}
{{#post}}
<div class="wrap dashboard">
  <header class="dash-head">
    <h1>{{title}}</h1>
    {{#if custom_excerpt}}<p class="art-deck">{{custom_excerpt}}</p>{{/if}}
  </header>
  <div class="gh-content dash-intro">{{content}}</div>
  <div data-dashboard>
    <p class="meta">Loading dashboard…</p>
  </div>
</div>
{{/post}}
