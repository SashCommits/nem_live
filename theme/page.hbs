{{!< default}}
{{#post}}
<article class="art page">
  {{#match @page.show_title_and_feature_image}}
  <header class="art-head narrow">
    <h1 class="art-title">{{title}}</h1>
    {{#if custom_excerpt}}<p class="art-deck">{{custom_excerpt}}</p>{{/if}}
  </header>
  {{#if feature_image}}
  {{!-- Was a single full-size image with no srcset, so phones downloaded the
        1200px file regardless of screen width. --}}
  <figure class="art-image">
    <img srcset="{{img_url feature_image size="s"}} 400w, {{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 2000w"
      sizes="(max-width: 1200px) 100vw, 1200px"
      src="{{img_url feature_image size="l"}}"
      width="1200" height="750" fetchpriority="high" decoding="async"
      alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
  </figure>
  {{/if}}
  {{/match}}
  <div class="gh-content art-body">{{content}}</div>
</article>
{{/post}}
